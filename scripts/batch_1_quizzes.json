  {
    "title": "Police Bharti Advanced Mock Test - 01",
    "description": "Advanced level questions focusing on Maharashtra Geography and History.",
    "category": "Police Bharti",
    "type": "mock_test",
    "questions": [
      {
        "id": "1001",
        "text": "\u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u093e\u091a\u094d\u092f\u093e \u092a\u0920\u093e\u0930\u093e\u0935\u0930 \u0916\u093e\u0932\u0940\u0932\u092a\u0948\u0915\u0940 \u0915\u094b\u0923\u0924\u094d\u092f\u093e \u0928\u0926\u0940\u091a\u0947 \u0916\u094b\u0930\u0947 \u0938\u0930\u094d\u0935\u093e\u0924 \u092e\u094b\u0920\u0947 \u0906\u0939\u0947?",
        "text_mr": "\u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u093e\u091a\u094d\u092f\u093e \u092a\u0920\u093e\u0930\u093e\u0935\u0930 \u0916\u093e\u0932\u0940\u0932\u092a\u0948\u0915\u0940 \u0915\u094b\u0923\u0924\u094d\u092f\u093e \u0928\u0926\u0940\u091a\u0947 \u0916\u094b\u0930\u0947 \u0938\u0930\u094d\u0935\u093e\u0924 \u092e\u094b\u0920\u0947 \u0906\u0939\u0947?",
        "options": [
          "\u092d\u0940\u092e\u093e \u0928\u0926\u0940\u091a\u0947 \u0916\u094b\u0930\u0947",
          "\u0915\u0943\u0937\u094d\u0923\u093e \u0928\u0926\u0940\u091a\u0947 \u0916\u094b\u0930\u0947",
          "\u0917\u094b\u0926\u093e\u0935\u0930\u0940 \u0928\u0926\u0940\u091a\u0947 \u0916\u094b\u0930\u0947",
          "\u0924\u093e\u092a\u0940-\u092a\u0942\u0930\u094d\u0923\u093e \u0928\u0926\u0940\u091a\u0947 \u0916\u094b\u0930\u0947"
        ],
        "correct_answer": "c",
        "explanation": "\u0917\u094b\u0926\u093e\u0935\u0930\u0940 \u0928\u0926\u0940\u091a\u0947 \u0916\u094b\u0930\u0947 \u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u093e\u0924\u0940\u0932 \u0938\u0930\u094d\u0935\u093e\u0924 \u092e\u094b\u0920\u0947 \u0916\u094b\u0930\u0947 \u0905\u0938\u0942\u0928, \u0924\u094d\u092f\u093e\u0928\u0947 \u0930\u093e\u091c\u094d\u092f\u093e\u091a\u0947 \u091c\u0935\u0933\u092a\u093e\u0938 49% \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0935\u094d\u092f\u093e\u092a\u0932\u0947 \u0906\u0939\u0947."
      },
      {
        "id": "1002",
        "text": "\u092e\u0930\u093e\u0920\u0935\u093e\u0921\u093e \u092e\u0941\u0915\u094d\u0924\u0940 \u0938\u0902\u0917\u094d\u0930\u093e\u092e\u093e\u0924 '\u0906\u0930\u094d\u092f \u0938\u092e\u093e\u091c\u093e\u091a\u0940' \u092d\u0942\u092e\u093f\u0915\u093e \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0940 \u0939\u094b\u0924\u0940. \u0939\u0948\u0926\u0930\u093e\u092c\u093e\u0926 \u0938\u0902\u0938\u094d\u0925\u093e\u0928\u093e\u0924 \u0906\u0930\u094d\u092f \u0938\u092e\u093e\u091c\u093e\u091a\u0940 \u092a\u0939\u093f\u0932\u0940 \u0936\u093e\u0916\u093e \u0915\u094b\u0920\u0947 \u0938\u094d\u0925\u093e\u092a\u0928 \u091d\u093e\u0932\u0940?",
        "text_mr": "\u092e\u0930\u093e\u0920\u0935\u093e\u0921\u093e \u092e\u0941\u0915\u094d\u0924\u0940 \u0938\u0902\u0917\u094d\u0930\u093e\u092e\u093e\u0924 '\u0906\u0930\u094d\u092f \u0938\u092e\u093e\u091c\u093e\u091a\u0940' \u092d\u0942\u092e\u093f\u0915\u093e \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0940 \u0939\u094b\u0924\u0940. \u0939\u0948\u0926\u0930\u093e\u092c\u093e\u0926 \u0938\u0902\u0938\u094d\u0925\u093e\u0928\u093e\u0924 \u0906\u0930\u094d\u092f \u0938\u092e\u093e\u091c\u093e\u091a\u0940 \u092a\u0939\u093f\u0932\u0940 \u0936\u093e\u0916\u093e \u0915\u094b\u0920\u0947 \u0938\u094d\u0925\u093e\u092a\u0928 \u091d\u093e\u0932\u0940?",
        "options": [
          "\u0914\u0930\u0902\u0917\u093e\u092c\u093e\u0926",
          "\u0927\u093e\u0930\u093e\u0936\u093f\u0935 (\u0909\u0938\u094d\u092e\u093e\u0928\u093e\u092c\u093e\u0926)",
          "\u0928\u093e\u0902\u0926\u0947\u0921",
          "\u092a\u0930\u092d\u0923\u0940"
        ],
        "correct_answer": "b",
        "explanation": "\u0939\u0948\u0926\u0930\u093e\u092c\u093e\u0926 \u0938\u0902\u0938\u094d\u0925\u093e\u0928\u093e\u0924 \u0906\u0930\u094d\u092f \u0938\u092e\u093e\u091c\u093e\u091a\u0940 \u092a\u0939\u093f\u0932\u0940 \u0936\u093e\u0916\u093e \u0967\u096e\u096f\u0968 \u092e\u0927\u094d\u092f\u0947 '\u0927\u093e\u0930\u093e\u0936\u093f\u0935' (\u0909\u0938\u094d\u092e\u093e\u0928\u093e\u092c\u093e\u0926) \u092f\u0947\u0925\u0947 \u0938\u094d\u0925\u093e\u092a\u0928 \u091d\u093e\u0932\u0940."
      },
      {
        "id": "1003",
        "text": "\u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930 \u092a\u094b\u0932\u0940\u0938 \u0905\u0927\u093f\u0928\u093f\u092f\u092e \u0967\u096f\u096b\u0967 \u0928\u0941\u0938\u093e\u0930, '\u0935\u093f\u0936\u0947\u0937 \u092a\u094b\u0932\u0940\u0938 \u0905\u0927\u093f\u0915\u093e\u0930\u0940' \u0928\u0947\u092e\u0923\u094d\u092f\u093e\u091a\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0915\u094b\u0923\u093e\u0932\u093e \u0906\u0939\u0947?",
        "text_mr": "\u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930 \u092a\u094b\u0932\u0940\u0938 \u0905\u0927\u093f\u0928\u093f\u092f\u092e \u0967\u096f\u096b\u0967 \u0928\u0941\u0938\u093e\u0930, '\u0935\u093f\u0936\u0947\u0937 \u092a\u094b\u0932\u0940\u0938 \u0905\u0927\u093f\u0915\u093e\u0930\u0940' \u0928\u0947\u092e\u0923\u094d\u092f\u093e\u091a\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0915\u094b\u0923\u093e\u0932\u093e \u0906\u0939\u0947?",
        "options": [
          "\u092a\u094b\u0932\u0940\u0938 \u092e\u0939\u093e\u0938\u0902\u091a\u093e\u0932\u0915",
          "\u091c\u093f\u0932\u094d\u0939\u093e\u0927\u093f\u0915\u093e\u0930\u0940",
          "\u092a\u094b\u0932\u0940\u0938 \u0905\u0927\u0940\u0915\u094d\u0937\u0915 (SP) \u0915\u093f\u0902\u0935\u093e \u092a\u094b\u0932\u0940\u0938 \u0906\u092f\u0941\u0915\u094d\u0924 (CP)",
          "\u0930\u093e\u091c\u094d\u092f \u0917\u0943\u0939\u092e\u0902\u0924\u094d\u0930\u0940"
        ],
        "correct_answer": "c",
        "explanation": "\u092e\u0939\u093e\u0930\u093e\u0937\u094d\u091f\u094d\u0930 \u092a\u094b\u0932\u0940\u0938 \u0915\u093e\u092f\u0926\u093e \u0967\u096f\u096b\u0967 \u091a\u094d\u092f\u093e \u0915\u0932\u092e \u0968\u0967 \u0928\u0941\u0938\u093e\u0930 \u0935\u093f\u0936\u0947\u0937 \u092a\u094b\u0932\u0940\u0938 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 (Special Police Officer) \u0928\u0947\u092e\u0923\u094d\u092f\u093e\u091a\u093e \u0905\u0927\u093f\u0915\u093e\u0930 SP \u0915\u093f\u0902\u0935\u093e CP \u092f\u093e\u0902\u0928\u093e \u0905\u0938\u0924\u094b."
      },
      {
        "id": "1004",
        "text": "\u0936\u093f\u0935\u093e\u091c\u0940 \u092e\u0939\u093e\u0930\u093e\u091c\u093e\u0902\u091a\u094d\u092f\u093e \u0905\u0937\u094d\u091f\u092a\u094d\u0930\u0927\u093e\u0928 \u092e\u0902\u0921\u0933\u093e\u0924 '\u0938\u0941\u092e\u0902\u0924' \u092f\u093e\u0902\u091a\u0947 \u092a\u094d\u0930\u092e\u0941\u0916 \u0915\u093e\u092e \u0915\u093e\u092f \u0939\u094b\u0924\u0947?",
        "text_mr": "\u0936\u093f\u0935\u093e\u091c\u0940 \u092e\u0939\u093e\u0930\u093e\u091c\u093e\u0902\u091a\u094d\u092f\u093e \u0905\u0937\u094d\u091f\u092a\u094d\u0930\u0927\u093e\u0928 \u092e\u0902\u0921\u0933\u093e\u0924 '\u0938\u0941\u092e\u0902\u0924' \u092f\u093e\u0902\u091a\u0947 \u092a\u094d\u0930\u092e\u0941\u0916 \u0915\u093e\u092e \u0915\u093e\u092f \u0939\u094b\u0924\u0947?",
        "options": [
          "\u0938\u0948\u0928\u094d\u092f\u093e\u091a\u0940 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e \u092a\u093e\u0939\u0923\u0947",
          "\u092a\u0930\u0930\u093e\u091c\u094d\u092f\u093e\u0902\u0936\u0940 \u0938\u0902\u092c\u0902\u0927 \u0920\u0947\u0935\u0923\u0947",
          "\u092a\u0924\u094d\u0930\u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0938\u093e\u0902\u092d\u093e\u0933\u0923\u0947",
          "\u0928\u094d\u092f\u093e\u092f\u0926\u093e\u0928 \u0915\u0930\u0923\u0947"
        ],
        "correct_answer": "b",
        "explanation": "\u0905\u0937\u094d\u091f\u092a\u094d\u0930\u0927\u093e\u0928 \u092e\u0902\u0921\u0933\u093e\u0924 '\u0938\u0941\u092e\u0902\u0924' (\u0930\u093e\u092e\u091a\u0902\u0926\u094d\u0930 \u0924\u094d\u0930\u094d\u092f\u0902\u092c\u0915 \u0921\u092c\u0940\u0930) \u092f\u093e\u0902\u091a\u0947 \u0915\u093e\u092e \u092a\u0930\u0930\u093e\u091c\u094d\u092f\u093e\u0902\u0936\u0940 (\u092a\u0930\u0930\u093e\u0937\u094d\u091f\u094d\u0930) \u0938\u0902\u092c\u0902\u0927 \u0920\u0947\u0935\u0923\u0947 \u0939\u0947 \u0939\u094b\u0924\u0947."
      },
      {
        "id": "1005",
        "text": "\u0916\u093e\u0932\u0940\u0932\u092a\u0948\u0915\u0940 \u0915\u094b\u0923\u0924\u0947 \u0935\u093e\u0915\u094d\u092f '\u0915\u0930\u094d\u092e\u0927\u093e\u0930\u092f \u0938\u092e\u093e\u0938\u093e\u091a\u0947' \u0909\u0926\u093e\u0939\u0930\u0923 \u0928\u093e\u0939\u0940?",
        "text_mr": "\u0916\u093e\u0932\u0940\u0932\u092a\u0948\u0915\u0940 \u0915\u094b\u0923\u0924\u0947 \u0935\u093e\u0915\u094d\u092f '\u0915\u0930\u094d\u092e\u0927\u093e\u0930\u092f \u0938\u092e\u093e\u0938\u093e\u091a\u0947' \u0909\u0926\u093e\u0939\u0930\u0923 \u0928\u093e\u0939\u0940?",
        "options": [
          "\u092e\u0939\u093e\u0926\u0947\u0935",
          "\u092d\u093e\u0937\u093e\u0902\u0924\u0930",
          "\u0935\u093f\u0926\u094d\u092f\u093e\u0927\u0928",
          "\u0928\u0940\u0932\u0915\u0902\u0920"
        ],
        "correct_answer": "d",
        "explanation": "\u0928\u0940\u0932\u0915\u0902\u0920 (\u0928\u093f\u0933\u093e \u0906\u0939\u0947 \u0915\u0902\u0920 \u091c\u094d\u092f\u093e\u091a\u093e \u0924\u094b) \u0939\u0947 '\u092c\u0939\u0941\u0935\u094d\u0930\u0940\u0939\u0940 \u0938\u092e\u093e\u0938\u093e\u091a\u0947' \u0909\u0926\u093e\u0939\u0930\u0923 \u0906\u0939\u0947. \u0907\u0924\u0930 \u0924\u0940\u0928 \u0915\u0930\u094d\u092e\u0927\u093e\u0930\u092f \u0938\u092e\u093e\u0938\u093e\u091a\u0940 \u0909\u0926\u093e\u0939\u0930\u0923\u0947 \u0906\u0939\u0947\u0924."
      }
    ]
  },
  {
    "title": "Police Bharti Advanced Mock Test - 02",
    "description": "Advanced level questions focusing on Indian Constitution and Science.",
    "category": "Police Bharti",
    "type": "mock_test",
    "questions": [
      {
        "id": "2001",
        "text": "\u092d\u093e\u0930\u0924\u0940\u092f \u0930\u093e\u091c\u094d\u092f\u0918\u091f\u0928\u0947\u0924\u0940\u0932 '\u092e\u0942\u0932\u092d\u0942\u0924 \u0915\u0930\u094d\u0924\u0935\u094d\u092f\u0947' (Fundamental Duties) \u0915\u094b\u0923\u0924\u094d\u092f\u093e \u0926\u0947\u0936\u093e\u091a\u094d\u092f\u093e \u0930\u093e\u091c\u094d\u092f\u0918\u091f\u0928\u0947\u0935\u0930\u0942\u0928 \u0918\u0947\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940 \u0906\u0939\u0947\u0924?",
        "text_mr": "\u092d\u093e\u0930\u0924\u0940\u092f \u0930\u093e\u091c\u094d\u092f\u0918\u091f\u0928\u0947\u0924\u0940\u0932 '\u092e\u0942\u0932\u092d\u0942\u0924 \u0915\u0930\u094d\u0924\u0935\u094d\u092f\u0947' (Fundamental Duties) \u0915\u094b\u0923\u0924\u094d\u092f\u093e \u0926\u0947\u0936\u093e\u091a\u094d\u092f\u093e \u0930\u093e\u091c\u094d\u092f\u0918\u091f\u0928\u0947\u0935\u0930\u0942\u0928 \u0918\u0947\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940 \u0906\u0939\u0947\u0924?",
        "options": [
          "\u0905\u092e\u0947\u0930\u093f\u0915\u093e",
          "\u0930\u0936\u093f\u092f\u093e (USSR)",
          "\u0906\u092f\u0930\u094d\u0932\u0902\u0921",
          "\u092c\u094d\u0930\u093f\u091f\u0928"
        ],
        "correct_answer": "b",
        "explanation": "\u092e\u0942\u0932\u092d\u0942\u0924 \u0915\u0930\u094d\u0924\u0935\u094d\u092f\u0947 42\u0935\u094d\u092f\u093e \u0918\u091f\u0928\u093e\u0926\u0941\u0930\u0941\u0938\u094d\u0924\u0940 (1976) \u0928\u0941\u0938\u093e\u0930 \u0938\u094d\u0935\u0930\u094d\u0923\u0938\u093f\u0902\u0939 \u0938\u092e\u093f\u0924\u0940\u091a\u094d\u092f\u093e \u0936\u093f\u092b\u093e\u0930\u0938\u0940\u0935\u0930\u0942\u0928 \u0930\u0936\u093f\u092f\u093e\u091a\u094d\u092f\u093e \u0918\u091f\u0928\u0947\u0935\u0930\u0942\u0928 \u0918\u0947\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940."
      },
      {
        "id": "2002",
        "text": "\u0930\u0915\u094d\u0924\u093e\u091a\u094d\u092f\u093e \u0917\u094b\u0920\u0923\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u0947\u0924 (Blood Clotting) \u0916\u093e\u0932\u0940\u0932\u092a\u0948\u0915\u0940 \u0915\u094b\u0923\u0924\u0947 \u091c\u0940\u0935\u0928\u0938\u0924\u094d\u0924\u094d\u0935 \u0906\u0935\u0936\u094d\u092f\u0915 \u0905\u0938\u0924\u0947?",
        "text_mr": "\u0930\u0915\u094d\u0924\u093e\u091a\u094d\u092f\u093e \u0917\u094b\u0920\u0923\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u0947\u0924 (Blood Clotting) \u0916\u093e\u0932\u0940\u0932\u092a\u0948\u0915\u0940 \u0915\u094b\u0923\u0924\u0947 \u091c\u0940\u0935\u0928\u0938\u0924\u094d\u0924\u094d\u0935 \u0906\u0935\u0936\u094d\u092f\u0915 \u0905\u0938\u0924\u0947?",
        "options": [
          "\u091c\u0940\u0935\u0928\u0938\u0924\u094d\u0924\u094d\u0935 A",
          "\u091c\u0940\u0935\u0928\u0938\u0924\u094d\u0924\u094d\u0935 B12",
          "\u091c\u0940\u0935\u0928\u0938\u0924\u094d\u0924\u094d\u0935 K",
          "\u091c\u0940\u0935\u0928\u0938\u0924\u094d\u0924\u094d\u0935 D"
